# Ensure shell scripts use LF line endings
*.sh text eol=lf

# Ensure batch files use CRLF line endings
*.bat text eol=crlf

# Ensure Python files use LF
*.py text eol=lf

# Ensure JavaScript/TypeScript files use LF
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.jsx text eol=lf
*.json text eol=lf

# Docker files use LF
Dockerfile text eol=lf
*.dockerfile text eol=lf
docker-compose*.yml text eol=lf
