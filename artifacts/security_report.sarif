          }
        },
        {
          "ruleId": "SEC-011",
          "level": "note",
          "message": { "text": "Payment reference validation only checks length (max 18 characters). Consider sanitizing special characters and validating against allowed character set to prevent injection in downstream systems." },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "frontend/src/pages/PaymentEntryPage.tsx" },
                "region": { "startLine": 121, "startColumn": 1 }
              }
            }
          ],
