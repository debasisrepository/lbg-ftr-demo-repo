# Local development configuration template
# Copy this file to .env and update values as needed

# Database configuration
# SQLite for local development (default)
DATABASE_URL=sqlite:///./app.db
# PostgreSQL for production
# DATABASE_URL=postgresql://user:password@localhost:5432/clearpath

# Optional separate database for status/incident data
STATUS_DATABASE_URL=

# Application role (case = case service, status = status service)
APP_ROLE=case

# JWT configuration - CHANGE THESE IN PRODUCTION
JWT_SECRET=dev-secret-change-me-in-production
JWT_ALGORITHM=HS256

# Session management (minutes)
SESSION_LIFETIME_MINUTES=30
SESSION_INACTIVITY_MINUTES=15
SESSION_MAX_MINUTES=480

# Login security
LOGIN_FAILURE_THRESHOLD=5
LOGIN_LOCK_MINUTES=15

# CORS configuration - comma-separated origins
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:5174

# External adapter mode (sandbox = mock, live = real integrations)
ADAPTER_MODE=sandbox
GATEWAY_BASE_URL=http://localhost:8080

# Timeouts and TTLs
AI_TIMEOUT_SECONDS=5
TOOL_CREDENTIAL_TTL_SECONDS=900
NOTIFICATION_LINK_TTL_HOURS=24

# Background job intervals
INCIDENT_POLL_SECONDS=20
SWEEP_INTERVAL_SECONDS=15
STATUS_MAX_AGE_SECONDS=60

# Business logic defaults
DEFAULT_REDIRECT_JOURNEY_CODE=existing_support
INTAKE_DEFAULT_OWNER_TEAM_CODE=INTAKE_DEFAULT
STATUS_RESOLVED_TAIL_MINUTES=30

# Logging and observability
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=

# Feature flags
DOCS_ENABLED=true
RATE_LIMIT_ENABLED=true
