# Local development environment (committed seed configuration)
# WARNING: SECRET_KEY below is for LOCAL DEVELOPMENT ONLY
# NEVER use this key in production. Generate a new secure key with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Set SECRET_KEY environment variable in production deployment (Kubernetes secret, AWS Secrets Manager, etc.)
DATABASE_URL=sqlite:///./app.db
SECRET_KEY=INSECURE_DEV_KEY_ONLY_DO_NOT_USE_IN_PRODUCTION_xxxxxxxx
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_INACTIVITY_TIMEOUT_MINUTES=15
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_ADDRESS_WINDOW_SECONDS=300
RATE_LIMIT_LOGIN_PER_ADDRESS_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_PER_CUSTOMER_WINDOW_SECONDS=300
RATE_LIMIT_LOGIN_PER_CUSTOMER_MAX_ATTEMPTS=10
BCRYPT_COST_FACTOR=12
PAYMENT_LIMIT_MINOR=100000000
FRESHNESS_TARGET_SECONDS=60
SCAM_CHECK_BUDGET_MS=300
HOLD_DECISION_BUSINESS_DAYS=4
