# Local development configuration
DATABASE_URL=sqlite:///./app.db
STATUS_DATABASE_URL=sqlite:////data/status.db

APP_ROLE=case
JWT_SECRET=dev-secret-change-me-in-production
JWT_ALGORITHM=HS256

SESSION_LIFETIME_MINUTES=30
SESSION_INACTIVITY_MINUTES=15
SESSION_MAX_MINUTES=480

LOGIN_FAILURE_THRESHOLD=5
LOGIN_LOCK_MINUTES=15

CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:5174

ADAPTER_MODE=sandbox
GATEWAY_BASE_URL=http://localhost:8080

AI_TIMEOUT_SECONDS=5
TOOL_CREDENTIAL_TTL_SECONDS=900
NOTIFICATION_LINK_TTL_HOURS=24
INCIDENT_POLL_SECONDS=20
SWEEP_INTERVAL_SECONDS=15
STATUS_MAX_AGE_SECONDS=60
DEFAULT_REDIRECT_JOURNEY_CODE=existing_support
INTAKE_DEFAULT_OWNER_TEAM_CODE=INTAKE_DEFAULT
STATUS_RESOLVED_TAIL_MINUTES=30

LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

DOCS_ENABLED=true
RATE_LIMIT_ENABLED=true
