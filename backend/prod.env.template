# Production Environment Configuration Template
# 
# CRITICAL SECURITY INSTRUCTIONS:
# 1. Generate a secure SECRET_KEY with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# 2. Store SECRET_KEY in secure secrets management (Kubernetes Secret, AWS Secrets Manager, HashiCorp Vault)
# 3. NEVER commit prod.env to source control - add to .gitignore
# 4. Rotate SECRET_KEY if compromised or on regular schedule (e.g., quarterly)
# 5. Use separate keys for each environment (dev, staging, production)

# Database - Use production PostgreSQL, not SQLite
DATABASE_URL=postgresql://user:password@host:5432/sample_bank

# JWT Configuration - GENERATE NEW SECRET KEY
SECRET_KEY=REPLACE_WITH_SECURE_KEY_FROM_SECRETS_MANAGER
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_INACTIVITY_TIMEOUT_MINUTES=15

# CORS - Restrict to production domain only
CORS_ORIGINS=https://app.samplebank.example.com

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_ADDRESS_WINDOW_SECONDS=300
RATE_LIMIT_LOGIN_PER_ADDRESS_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_PER_CUSTOMER_WINDOW_SECONDS=300
RATE_LIMIT_LOGIN_PER_CUSTOMER_MAX_ATTEMPTS=10

# Security
BCRYPT_COST_FACTOR=12

# Business Rules
PAYMENT_LIMIT_MINOR=100000000
FRESHNESS_TARGET_SECONDS=60
SCAM_CHECK_BUDGET_MS=300
HOLD_DECISION_BUSINESS_DAYS=4

# Logging - Use structured logging in production
LOG_LEVEL=INFO
LOG_FORMAT=json

# Monitoring
ENABLE_METRICS=true
ENABLE_TRACING=true

# Debug - MUST be false in production
DEBUG=false
